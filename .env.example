# Copy to .env (local) or set in Render's Environment tab.
# .env is gitignored — never commit real keys.

# --- Clash of Clans (via the RoyaleAPI proxy) ---
COC_TOKEN=
CLAN_TAG=#2C89UQJ8P

# --- Supabase (Riuka project; service role stays server-side only) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers (either or both; /ask falls back to the other on failure) ---
SARVAM_TOKEN=
GEMINI_API_KEY=
# Optional overrides:
# AI_PROVIDER=sarvam            # default provider: sarvam | gemini
# SARVAM_MODEL=sarvam-2b
# GEMINI_MODEL=gemini-2.0-flash

# --- Background polling ---
# Live-event poll interval, clamped to 10s-10min. Idle checks happen every 5min.
BG_POLL_INTERVAL_MS=30000

# --- Roster snapshots ---
# player_snapshots keeps only the N most recent batches (default 12).
# SNAPSHOT_KEEP_BATCHES=12

# --- Security (optional) ---
# If RUKA_ACCESS_TOKEN is set, every API route requires the X-Access-Token
# header and the dashboard asks for the token once.
# RUKA_ACCESS_TOKEN=
# If ALLOWED_ORIGIN is set, CORS is locked to that origin instead of *.
# ALLOWED_ORIGIN=https://clan-war-room.onrender.com

# --- Server ---
PORT=8787
